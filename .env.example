# Copy to .env (or `export` these) to override defaults.
# Local demo works with none of these set.

# --- city / grid ---------------------------------------------------------
BB_CITY=Delhi
BB_CENTER_LAT=28.6100
BB_CENTER_LON=77.1900
BB_GRID_RES_M=500
BB_GRID_ROWS=32
BB_GRID_COLS=44
BB_FORECAST_HOURS=6
# Seasonal stubble-burning plume from data/events.json (false = clean baseline).
BB_STUBBLE_BURNING=true

# --- server --------------------------------------------------------------
BB_HOST=127.0.0.1
BB_PORT=8000

# --- AWS (LocalStack or real). Leave BB_USE_AWS=false for offline demo. --
BB_USE_AWS=false
# Use the LLM-backed Strands agent (needs a model; Bedrock on AWS).
BB_USE_STRANDS=false
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=ap-south-1
BB_S3_RAW_BUCKET=breathebuddy-raw
BB_DDB_READINGS_TABLE=breathebuddy-readings
BB_DDB_ALERTS_TABLE=breathebuddy-alerts
BB_DDB_SUBSCRIBERS_TABLE=breathebuddy-subscribers
BB_SNS_TOPIC_ARN=
BB_SQS_QUEUE_URL=
BB_OPENSEARCH_ENDPOINT=
