# Copy to .env (or `export` these) to override defaults.
# Local demo works with none of these set.

# --- city / grid ---------------------------------------------------------
BB_CITY=Delhi
BB_CENTER_LAT=28.6100
BB_CENTER_LON=77.1900
BB_GRID_RES_M=500
BB_GRID_ROWS=32
BB_GRID_COLS=44
BB_FORECAST_HOURS=6
# Seasonal stubble-burning plume from data/events.json (false = clean baseline).
BB_STUBBLE_BURNING=true

# --- server --------------------------------------------------------------
BB_HOST=127.0.0.1
BB_PORT=8000

# --- data source ---------------------------------------------------------
# mock = bundled feed (offline). openaq = live OpenAQ v3 (needs an API key);
# any live-feed error automatically falls back to mock.
BB_AQ_SOURCE=mock
BB_OPENAQ_API_KEY=
BB_OPENAQ_RADIUS_M=25000

# --- AWS (LocalStack or real). Leave BB_USE_AWS=false for offline demo. --
BB_USE_AWS=false
# Use the LLM-backed Strands agent (Strands Agents SDK + Amazon Bedrock).
BB_USE_STRANDS=false
# Optional Bedrock model id (blank = SDK default for the region).
BB_STRANDS_MODEL=global.anthropic.claude-sonnet-4-6
# Bedrock API key (bearer token) — lets the agent run without SigV4 creds.
BB_BEDROCK_API_KEY=
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=ap-south-1
BB_S3_RAW_BUCKET=breathebuddy-raw
BB_DDB_READINGS_TABLE=breathebuddy-readings
BB_DDB_ALERTS_TABLE=breathebuddy-alerts
BB_DDB_SUBSCRIBERS_TABLE=breathebuddy-subscribers
BB_SNS_TOPIC_ARN=
BB_SQS_QUEUE_URL=
BB_OPENSEARCH_ENDPOINT=
# Optional SageMaker endpoint for the nowcast model (blank = local model).
BB_SAGEMAKER_ENDPOINT=
# CloudWatch custom-metric namespace.
BB_METRICS_NAMESPACE=BreatheBuddy

# --- auth (Amazon Cognito) ----------------------------------------------
# Require a bearer token on write endpoints (/subscribe, /cycle).
# With a pool set, JWTs are signature-verified against the pool JWKS (needs
# `pip install PyJWT cryptography`); otherwise presence-only (dev) is used.
BB_REQUIRE_AUTH=false
BB_COGNITO_USER_POOL_ID=
BB_COGNITO_CLIENT_ID=
# Optional overrides for the derived issuer / JWKS URL.
BB_COGNITO_ISSUER=
BB_COGNITO_JWKS_URL=
# Per-client write rate limit for /subscribe and /cycle (0 disables). -> HTTP 429
BB_WRITE_RATE_LIMIT_PER_MIN=60

# --- alerts --------------------------------------------------------------
BB_DEFAULT_THRESHOLD_AQI=150
BB_ALERT_COOLDOWN_MIN=60
